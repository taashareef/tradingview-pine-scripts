// Error Margins
errorPercent = strictMode ? strictErrorPercent : normalErrorPercent
err_min = (100.0 - errorPercent) / 100.0
err_max = (100.0 + errorPercent) / 100.0

// ZigZag Line Styles (Thin and Dashed for Professional Look)
zigzagWidth = 1
zigzagStyle = line.style_dashed

